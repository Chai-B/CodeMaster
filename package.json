{
  "name": "codemaster-next",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "description": "A persistent reasoning operating system for AI software engineering",
  "scripts": {
    "start": "tsx src/index.tsx",
    "dev": "tsx watch src/index.tsx",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/unit/*.test.ts tests/integration/*.test.ts tests/e2e/*.test.ts",
    "bench": "node --import tsx bench/run.ts"
  },
  "files": [
    "bin/",
    "src/",
    "tsconfig.json",
    "readme.md"
  ],
  "bin": {
    "codemaster": "./bin/codemaster.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "@google/generative-ai": "^0.24.1",
    "@xenova/transformers": "^2.17.2",
    "chokidar": "^4.0.0",
    "ink": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "js-yaml": "^4.1.0",
    "openai": "^6.45.0",
    "react": "^18.3.0",
    "simple-git": "^3.27.0",
    "strip-ansi": "^7.1.0",
    "tree-sitter-wasms": "^0.1.13",
    "tsx": "^4.19.0",
    "vscode-jsonrpc": "^9.0.0",
    "web-tree-sitter": "^0.20.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT"
}
